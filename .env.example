# Local synthetic demo settings only. Run `make init-demo-env` to create an
# ignored .env containing randomly generated secrets. Never commit .env.
# Compose supplies role-specific database URLs and does not publish DB ports.
APP_MODE=demo
PRODUCT_DATABASE_URL=postgres://settlegraph@product-db:5432/settlegraph?sslmode=disable
BANKSIM_DATABASE_URL=postgres://banksim@banksim-db:5432/banksim?sslmode=disable
# Each process sets LISTEN_ADDR to its own port: api 8080, worker 8081, banksim 8082.
# Required local secrets: DEMO_ACCESS_CODE (16+ chars), DEMO_JWT_SECRET,
# BANKSIM_ADMIN_TOKEN, BANKSIM_PROVIDER_TOKEN, BANKSIM_EVALUATOR_TOKEN,
# BANKSIM_WEBHOOK_SECRET (each 32+ chars except the access code).
# Optional distinct demo principal access codes (16+ chars, generated by init-demo-env):
# DEMO_REVIEWER_ACCESS_CODE, DEMO_ANALYST_ACCESS_CODE, DEMO_VIEWER_ACCESS_CODE.
# Display-name input never changes principal role or renames shared demo users.
# Host ports can be overridden with API_PORT, BANKSIM_PORT, WEB_PORT.
# Offline analysis is the deterministic local default. Explicit BEDROCK also
# requires AWS_REGION and BEDROCK_MODEL_ID; credentials belong in a secure
# runtime credential provider, never this file. See docs/bedrock.md.
INVESTIGATION_PROVIDER=OFFLINE_STUB
# Per-process requests/minute; provider delivery is excluded.
DEMO_AUTH_RATE_LIMIT=30
EXPENSIVE_RATE_LIMIT=120
