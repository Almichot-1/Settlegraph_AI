# No AWS or banking credentials required to develop the UI.
# Mock mode uses deterministic financial simulation data. Never label it as a real bank feed.
SETTLEGRAPH_DATA_MODE=mock
# To integrate with Go backend, use SETTLEGRAPH_DATA_MODE=backend
SETTLEGRAPH_API_BASE_URL=http://localhost:8080
# Backend-only secret used by the Next.js server for POST /v1/demo/sessions.
# Do not prefix this with NEXT_PUBLIC_.
DEMO_ACCESS_CODE=replace-with-your-local-backend-demo-code
# Optional: set a secure cookie over HTTPS when deployed.
# NODE_ENV=production
